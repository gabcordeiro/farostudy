# =============================================================================
# Faro Cards - variaveis de ambiente (checklist de seguranca #1, #3)
# Copie para `.env.local`. NUNCA commite o arquivo real.
# Apenas chaves PUBLICAS/ANONIMAS podem viver no frontend (prefixo VITE_).
# =============================================================================

# Supabase (client-side, seguro para expor: protegido por RLS)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Analytics (opcional, id publico)
VITE_ANALYTICS_ID=""

# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY - jamais prefixar com VITE_ e jamais enviar ao browser.
# Usar somente em Supabase Edge Functions / backend.
# -----------------------------------------------------------------------------
# GEMINI_API_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."
